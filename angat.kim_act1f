                print("\nSOLUTION CODE:")
                print("""
number1 = 10
number2 = 5

total = number1 + number2

print("Sum:", total)
""")

                print("PROGRAM EXECUTION:")

                number1 = 10
                number2 = 5

                total = number1 + number2

                print("First number:", number1)
                print("Second number:", number2)
                print("Sum:", total)

                print("\nEXPLANATION:")
                print("The program uses two variables.")
                print("The addition operator adds the values.")
                print("The print() function displays the sum.")

                input("\nPress Enter to continue...")

            # ----------------------------------
