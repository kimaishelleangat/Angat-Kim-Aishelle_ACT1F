for number in range(1, 6):
    print(number)
""")

                print("PROGRAM EXECUTION:")

                for number in range(1, 6):
                    print(number)

                print("\nEXPLANATION:")
                print("The for loop repeats the print() statement.")
                print("The range(1, 6) produces numbers from 1 to 5.")
                print("The ending number is not included.")

