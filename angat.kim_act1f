            elif problem_choice == "2":

                print("\nPROBLEM 2: IDENTIFY EVEN OR ODD")

                print("Problem:")
                print("Determine whether a given number is even or odd.")

                print("\nSOLUTION CODE:")
                print("""
number = 8

if number % 2 == 0:
    print("Even number")
else:
    print("Odd number")
""")

                print("PROGRAM EXECUTION:")

                number = 8

                if number % 2 == 0:
                    print("Even number")
                else:
                    print("Odd number")

                print("\nEXPLANATION:")
                print("The modulus operator checks the remainder.")
                print("If the remainder is zero, the number is even.")
                print("Otherwise, the number is odd.")

                input("\nPress Enter to continue...")

